# ==============================
# FastAPI 模型服务配置文件
# 请根据实际情况修改以下参数
# ==============================

# API 认证密钥（客户端请求需携带）
API_KEY='fast8888'

# 服务监听端口
PORT=8080

# ------------------------------
# 【必填】模型部署策略
# ------------------------------
# 是否部署 Embedding 模型 (true / false)
DEPLOY_EMBEDDING='true'

# 是否部署 Reranker 模型 (true / false)
DEPLOY_RERANKER='false'

# ------------------------------
# 【必填】设备指定
# ------------------------------
# Embedding 模型运行设备 (cuda / cpu)
EMBEDDING_DEVICE='cuda'

# Reranker 模型运行设备 (cuda / cpu)
RERANKER_DEVICE='cuda'

# ------------------------------
# 【可选】模型路径（留空则首次运行 config.py 时弹窗选择）
# ------------------------------
EMBEDDING_MODEL_PATH='C:/Server/Reranker-Qwen/models/Qwen3-Embedding-0.6B'
RERANKER_MODEL_PATH='C:/Server/Reranker-Qwen/models/Qwen3-Reranker-0.6B'